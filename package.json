{
  "name": "website-clone-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node src/scripts/clean-next-cache.mjs && next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env src/scripts/seed-styles.ts",
    "db:seed:admin": "tsx --env-file=.env src/scripts/seed-admin.ts",
    "db:init": "npm run db:push && npm run db:seed:admin && npm run db:seed",
    "env:check": "tsx --env-file=.env src/scripts/check-env.ts",
    "mail:test": "tsx --env-file=.env src/scripts/test-brevo.ts"
  },
  "dependencies": {
    "@getbrevo/brevo": "^5.0.4",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.21.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
